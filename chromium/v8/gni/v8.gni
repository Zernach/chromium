# Stub file for standalone builds without V8 dependency

declare_args() {
  # Whether to use external startup data for V8.
  # Default to true for standalone builds.
  v8_use_external_startup_data = true
}

# Default snapshot toolchain for V8.
# Stub value for standalone builds.
v8_snapshot_toolchain = ""

# Path to V8 inspector JS protocol file.
v8_inspector_js_protocol = "//v8/src/inspector/js_protocol.json"
